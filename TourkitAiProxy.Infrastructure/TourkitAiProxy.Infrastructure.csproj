<Project Sdk="Microsoft.NET.Sdk">

  <!-- ════════════════════════════════════════════════════════════════════════
       CÀI ĐẶT — mọi thứ chạm ra thế giới bên ngoài.

       Vào được : repository Dapper (SQL Server + PostgreSQL), HttpClient gọi TourKit.Api
                  và các nhà cung cấp AI, adapter kênh chat, kho tệp R2/S3/đĩa, Redis, log.
       Nguyên tắc: mỗi lớp ở đây CÀI một giao diện do Application khai.

       ⚠️ Chỉ tầng này được mở kết nối CSDL. Sau khi tách xong, luật đó do BIÊN DỊCH VIÊN
       ép (Application không tham chiếu Dapper) chứ không còn là nguyện vọng trong tài liệu.
       ════════════════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TourkitAiProxy.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TourkitAiProxy.Application\TourkitAiProxy.Application.csproj" />
    <ProjectReference Include="..\TourkitAiProxy.Domain\TourkitAiProxy.Domain.csproj" />
    <ProjectReference Include="..\TourkitAiProxy.Shared\TourkitAiProxy.Shared.csproj" />
  </ItemGroup>

</Project>
